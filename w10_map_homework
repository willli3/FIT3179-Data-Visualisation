{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Mobile vs Fixed Broadband — Median Speed (Mbps)",
  "width": 800,
  "height": 600,

  "data": { "url": "https://raw.githubusercontent.com/willli3/FIT3179-Data-Visualisation/refs/heads/main/fixed_fixedbroadband.csv" },

  "params": [
    {
      "name": "MinBroadband",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 300,
        "step": 5,
        "name": "Minimum Broadband (Mbps): "
      }
    },
    {
      "name": "Continent_selection",
      "bind": {
        "input": "select",
        "options": [null, "AF", "AS", "EU", "NA", "OC", "SA"],
        "labels": ["Show All", "Africa", "Asia", "Europe", "North America", "Oceania", "South America"],
        "name": "Continent: "
      }
    }
  ],

  "transform": [
    {
      "lookup": "country_code",
      "from": {
        "data": { "url": "https://raw.githubusercontent.com/willli3/FIT3179-Data-Visualisation/refs/heads/main/fixed_mobile.csv" },
        "key": "country_code",
        "fields": ["median_speed(mbps)"]
      },
      "as": "mobile_speed"
    },
    { "calculate": "datum['median_speed(mbps)']", "as": "broadband_speed" },

    { "filter": "isValid(datum.mobile_speed) && isValid(datum.broadband_speed)" },
    { "filter": "datum.broadband_speed >= MinBroadband" },
    {
      "filter": "Continent_selection == null || datum.continent_code == Continent_selection"
    }
  ],

  "mark": { "type": "circle", "opacity": 0.7 },

  "encoding": {
    "x": {
      "field": "broadband_speed",
      "type": "quantitative",
      "title": "Fixed Broadband — Median Speed (Mbps)"
    },
    "y": {
      "field": "mobile_speed",
      "type": "quantitative",
      "title": "Mobile — Median Speed (Mbps)"
    },
    "size": {
      "field": "broadband_speed",
      "type": "quantitative",
      "title": "Broadband speed",
      "legend": {"format": ".0f"},
      "scale": { "range": [20, 600] }
    },
    "color": {
      "field": "continent_code",
      "type": "nominal",
      "title": "Continent",
      "scale": {
        "domain": ["AF", "AS", "EU", "NA", "OC", "SA"],
        "range": ["#a6cee3", "#377eb8", "#ff7f00", "#e41a1c", "#1b9e77", "#984ea3"]
      }
    },
    "tooltip": [
      {"field": "country", "title": "Country"},
      {"field": "country_code", "title": "Code"},
      {"field": "continent_code", "title": "Continent"},
      {"field": "broadband_speed", "title": "Fixed Broadband (Mbps)", "type": "quantitative", "format": ".2f"},
      {"field": "mobile_speed", "title": "Mobile (Mbps)", "type": "quantitative", "format": ".2f"}
    ]
  },

  "config": { "view": { "stroke": null } }
}
