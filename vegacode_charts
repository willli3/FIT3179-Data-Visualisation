broadband:


{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Fixed Broadband Speeds (Median Mbps) in comparison to Australia",
  "width": 720,
  "height": 360,
  "data": {
    "url": "https://raw.githubusercontent.com/willli3/FIT3179-Data-Visualisation/main/fixed_fixedbroadband.csv"
  },
  "transform": [
    {
      "filter": "indexof(['Singapore','Hong Kong (SAR)','Chile','United Arab Emirates','Iceland','Australia'], datum.country) >= 0"
    },
    { "calculate": "toNumber(datum['median_speed(mbps)'])", "as": "broadband_speed" }
  ],
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3 },
      "encoding": {
        "x": {
          "field": "country",
          "type": "nominal",
          "sort": "-y",
          "title": null,
          "axis": { "labelAngle": 0 }
        },
        "y": {
          "field": "broadband_speed",
          "type": "quantitative",
          "title": "Fixed Broadband — Median Speed (Mbps)"
        },
        "color": { "value": "#377eb8" },
        "tooltip": [
          { "field": "country", "title": "Country" },
          { "field": "broadband_speed", "title": "Median Speed (Mbps)", "type": "quantitative", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "baseline": "bottom", "dy": -3, "fontWeight": "600" },
      "encoding": {
        "x": { "field": "country", "type": "nominal", "sort": "-y" },
        "y": { "field": "broadband_speed", "type": "quantitative" },
        "text": { "field": "broadband_speed", "type": "quantitative", "format": ".1f" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "labelFontSize": 12, "titleFontSize": 12 }
  }
}

